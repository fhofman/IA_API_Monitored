# Copiá este archivo a .env y completá los valores. NO subas .env al repo.

# --- LLM (obligatoria para el worker) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Búsqueda web del investigador (opcional: sin ella solo consulta OSV) ---
TAVILY_API_KEY=

# --- Redis (cola de jobs + checkpointer). En docker compose se sobreescribe a redis://redis:6379/0 ---
REDIS_URL=redis://localhost:6379/0

# --- Phoenix (observabilidad). En docker compose se sobreescribe a http://phoenix:6006 ---
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=vuln-orchestrator
# PHOENIX_TRACING=false        # desactiva el tracing
# PHOENIX_API_KEY=             # solo para Phoenix Cloud
# PHOENIX_WAIT_SECONDS=30      # cuánto espera el worker a que Phoenix responda

# --- Worker ---
WORKER_CONCURRENCY=5
JOB_TIMEOUT_SECONDS=600

# --- Prueba de carga (scripts/load_test.py) ---
API_BASE_URL=http://localhost:8000
